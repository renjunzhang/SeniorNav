#!/usr/bin/env bash
# SeniorNav pre-commit guard
# 拦截：密钥/凭据文件、疑似令牌、手机号/身份证、本地隐私词、超大文件
# 详见 docs/GIT_COMMIT_RULES.md；不要用 --no-verify 绕过。
set -uo pipefail

red()  { printf '\033[31m%s\033[0m\n' "$*" >&2; }
warn() { printf '\033[33m%s\033[0m\n' "$*" >&2; }

mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR)
if ((${#files[@]} == 0)); then
  exit 0
fi

fail=0

# ---------- 1. 禁止提交的文件名 ----------
blocked='(^|/)(\.env(\..*)?|id_(rsa|dsa|ecdsa|ed25519)(\.pub)?|[^/]*\.(pem|key|p12|pfx|jks|keystore|mobileprovision|provisionprofile)|key\.properties|local\.properties|google-services\.json|secrets?\.(json|ya?ml|txt))$'
for f in "${files[@]}"; do
  if [[ "$f" =~ $blocked ]]; then
    red "禁止提交凭据/密钥/本机配置文件: $f"
    fail=1
  fi
done

# ---------- 2. 超大文件 ----------
while IFS=$'\t' read -r add _del path; do
  [[ "$add" == "-" ]] || continue
  size=$(git cat-file -s ":$path" 2>/dev/null || echo 0)
  if (( size > 5242880 )); then
    red "文件超过 5MB，请确认是否应提交: $path ($size bytes)"
    fail=1
  fi
done < <(git diff --cached --numstat)

# ---------- 3. 高置信度密钥/令牌 ----------
# 注意：只报告文件与行号，绝不打印匹配内容，避免二次泄露。
secret_re='-----BEGIN ([A-Z0-9]+ )?PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{60,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|xox[baprs]-[A-Za-z0-9-]{10,}|(^|[^A-Za-z0-9])(BAIDU|MAP|API|SECRET|ACCESS|PRIVATE)[_-]?(KEY|AK|TOKEN|SECRET)[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9_./+-]{16,}|(^|[^A-Za-z0-9_])(ak|api_?key|apikey|token|secret|password|passwd|pwd)[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{24,}["'"'"']'
secret_hits=$(git grep -nI --cached -E -e "$secret_re" -- "${files[@]}" 2>/dev/null | cut -d: -f1,2 | head -20 || true)
if [[ -n "$secret_hits" ]]; then
  red "疑似密钥/Token（内容已隐藏）："
  printf '%s\n' "$secret_hits" >&2
  fail=1
fi

# ---------- 4. 手机号 / 身份证 ----------
personal_re='(^|[^0-9])1[3-9][0-9]{9}([^0-9]|$)|(^|[^0-9])[1-9][0-9]{5}(19|20)[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])[0-9]{3}[0-9Xx]([^0-9]|$)'
personal_hits=$(git grep -nI --cached -E -e "$personal_re" -- "${files[@]}" 2>/dev/null | cut -d: -f1,2 | head -20 || true)
if [[ -n "$personal_hits" ]]; then
  red "疑似手机号/身份证号（请改用虚构值）："
  printf '%s\n' "$personal_hits" >&2
  fail=1
fi

# ---------- 5. 本地隐私词（.git/privacy-terms，永不提交）----------
git_dir=$(git rev-parse --absolute-git-dir)
terms_file="$git_dir/privacy-terms"
if [[ -f "$terms_file" ]]; then
  term_args=()
  while IFS= read -r t; do
    t="${t%$'\r'}"
    [[ -z "$t" || "$t" == \#* ]] && continue
    term_args+=(-e "$t")
  done < "$terms_file"

  if ((${#term_args[@]})); then
    term_hits=$(git grep -nI --cached -F "${term_args[@]}" -- "${files[@]}" 2>/dev/null | cut -d: -f1,2 | head -20 || true)
    if [[ -n "$term_hits" ]]; then
      red "命中本地隐私词（词表在 .git/privacy-terms，内容已隐藏）："
      printf '%s\n' "$term_hits" >&2
      fail=1
    fi
  fi
else
  warn "提示：未配置 .git/privacy-terms，本次未检查真实小区名/坐标/UID。"
fi

# ---------- 6. gitleaks（可选）----------
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact --no-banner >/dev/null 2>&1; then
    red "gitleaks 检查未通过；运行 gitleaks protect --staged --redact 查看详情。"
    fail=1
  fi
fi

# ---------- 7. 结果 ----------
if ((fail)); then
  cat >&2 <<'EOF'
------------------------------------------------------------
提交已阻止。请移除上述内容后重新 git add。
不要用 --no-verify 绕过；紧急流程见 docs/GIT_COMMIT_RULES.md §9。
若已经提交：先轮换密钥，再清理历史（删除 commit 不够）。
------------------------------------------------------------
EOF
  exit 1
fi

exit 0
